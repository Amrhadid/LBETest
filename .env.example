# Supabase configuration for LBETest.com
#
# These values are already configured in the Cloudflare project settings.
# Copy this file to `.env.local` for local development and fill in the values
# from your Supabase project (Project Settings -> API). Never commit real keys.

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser
# and never prefix with NEXT_PUBLIC_. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
