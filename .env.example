# Supabase configuration for LBETest.com
#
# These values are already configured in the Cloudflare project settings.
# Copy this file to `.env.local` for local development and fill in the values
# from your Supabase project (Project Settings -> API). Never commit real keys.

# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser
# and never prefix with NEXT_PUBLIC_. Used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for AI grading of open-ended items (types 4 & 5).
# SERVER ONLY. Set as a Cloudflare Worker secret:
#   wrangler secret put ANTHROPIC_API_KEY
# Grading (claude-sonnet-5) is skipped until this is set.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Cloud Speech-to-Text API key for transcribing spoken responses
# (types 3 & 6) before AI grading. SERVER ONLY. Use a Google Cloud API key
# restricted to the "Cloud Speech-to-Text API" (NOT a service-account JSON —
# an API key is a single Worker-friendly fetch, no JWT signing). Set as a
# Cloudflare Worker secret:
#   wrangler secret put GOOGLE_STT_API_KEY
# Voice transcription is skipped until this is set.
GOOGLE_STT_API_KEY=your-google-stt-api-key
